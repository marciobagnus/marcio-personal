# URL canónica final. No incluir barra final. Sin ella: noindex y sitemap vacío.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Las métricas se habilitan sólo con consentimiento. Activar en el proyecto Vercel también.
NEXT_PUBLIC_VERCEL_ANALYTICS=false
NEXT_PUBLIC_SPEED_INSIGHTS=false
# Requiere Vercel Pro/Enterprise; "soy pro en código" no significa tener ese plan.
NEXT_PUBLIC_VERCEL_CUSTOM_EVENTS=false
# GA4 opcional: reemplazar con tu Measurement ID real.
NEXT_PUBLIC_GA_ID=
# Tráfico en development deshabilitado salvo debug explícito.
NEXT_PUBLIC_ANALYTICS_DEBUG=false
